add_action( 'template_redirect', 'restrict_access_to_specific_urls' );
add_action( 'admin_init', 'restrict_admin_urls_for_roles' );

function restrict_access_to_specific_urls() {
    // Get the current user's role
    $user = wp_get_current_user();
    $roles = (array) $user->roles;

    // Roles that should not have access
    $restricted_roles = array( 'subscriber', 'customer','vendedor','contributor' ); // Add restricted roles here

    // URLs to restrict on the frontend
    $restricted_urls = array(
        site_url( '/my-account/edit-account/' ),
        site_url( '/my-account/some-other-page/' ) // Add other frontend URLs here
    );

    // Check if user has a restricted role and is on a restricted URL
    if ( array_intersect( $roles, $restricted_roles ) ) {
        foreach ( $restricted_urls as $url ) {
            if ( trailingslashit( esc_url_raw( $url ) ) === trailingslashit( esc_url_raw( home_url( $_SERVER['REQUEST_URI'] ) ) ) ) {
                wp_redirect( home_url( '/my-account/' ) ); // Redirect to the My Account page
                exit;
            }
        }
    }
}

function restrict_admin_urls_for_roles() {
    // Get the current user's role
    $user = wp_get_current_user();
    $roles = (array) $user->roles;

    // Roles that should not have access
    $restricted_roles = array( 'subscriber', 'customer','vendedor','contributor' ); // Add restricted roles here

    // Admin URLs to restrict
    $restricted_admin_urls = array(
        'admin.php?page=wc-settings',
        'admin.php?page=wc-status',
		'admin.php?page=th_checkout_field_editor_pro',
		'admin.php?page=wc-order-export',
		'admin.php?page=tm-global-epo',
		'admin.php?page=wc-settings&tab=checkout',
		'wp-admin/profile.php',
		'wp-admin/admin.php?page=yaymail-settings',
		'wp-admin/admin.php?page=tcepo-settings'
		// Add other admin URLs here
    );

    // Check if user has a restricted role and is on a restricted admin URL
    if ( array_intersect( $roles, $restricted_roles ) && is_admin() ) {
        $current_url = $_SERVER['REQUEST_URI'];
        foreach ( $restricted_admin_urls as $admin_url ) {
            if ( strpos( $current_url, $admin_url ) !== false ) {
                wp_redirect( admin_url() ); // Redirect to the WordPress dashboard
                exit;
            }
        }
    }
}
