add_action( 'wp_footer', 'conditionally_hide_order_payment_receipt_for_wompi' );

function conditionally_hide_order_payment_receipt_for_wompi() {
    // Ensure the script is only added on the checkout page
    if ( is_checkout() && ! is_wc_endpoint_url('order-received') ) {
        ?>
        <script type="text/javascript">
            jQuery(function($) {
                // Function to check and hide the field based on the selected payment gateway
                function checkAndHideField() {
                    var chosen_gateway = $('input[name="payment_method"]:checked').val();

                    // If the WOMPI gateway is selected, hide the field
                    if ( chosen_gateway === 'wompi' || chosen_gateway === 'cod') {
                        $('#order_payment_receipt_field').hide();
                    } else {
                        $('#order_payment_receipt_field').show();
                    }
                }

                // Run the check when the page loads
                checkAndHideField();

                // Listen for changes in the payment gateway selection
                $('input[name="payment_method"]').on('change', function() {
                    checkAndHideField();
                });

                // Also listen for updates to the checkout (e.g., AJAX updates)
                $(document.body).on('updated_checkout', function() {
                    checkAndHideField();
                });
            });
        </script>
        <?php
    }
}



