add_filter( 'woocommerce_account_menu_items', 'remove_edit_account_for_specific_roles', 99 );

function remove_edit_account_for_specific_roles( $menu_links ) {
    // Get the current user's role
    $user = wp_get_current_user();
    $roles = (array) $user->roles;

    // Roles that cannot access the Edit Account tab
    $restricted_roles = array( 'subscriber', 'customer','vendedor','contributor' ); // Add roles here

    // If the user has a restricted role, remove the Edit Account tab
    if ( array_intersect( $roles, $restricted_roles ) ) {
        unset( $menu_links['edit-account'] );
    }

    return $menu_links;
}

